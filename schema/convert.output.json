{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mystilink.example/schema/convert.output.json",
  "title": "mystilink-lunar convert output (alpha.1)",
  "type": "object",
  "required": ["solar", "lunar", "ganzhi", "zodiac", "rules", "provider"],
  "properties": {
    "solar": {
      "type": "object",
      "required": ["datetime", "timezone", "year", "month", "day"],
      "properties": {
        "datetime": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string" },
        "year": { "type": "integer" },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 }
      }
    },
    "lunar": {
      "type": "object",
      "required": ["year", "month", "day", "is_leap_month"],
      "properties": {
        "year": { "type": "integer" },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": 1, "maximum": 30 },
        "is_leap_month": { "type": "boolean" }
      }
    },
    "ganzhi": {
      "type": "object",
      "required": ["year"],
      "properties": {
        "year": {
          "type": "object",
          "required": ["stem_index", "branch_index", "stem", "branch", "text"],
          "properties": {
            "stem_index": { "type": "integer", "minimum": 0, "maximum": 9 },
            "branch_index": { "type": "integer", "minimum": 0, "maximum": 11 },
            "stem": { "type": "string" },
            "branch": { "type": "string" },
            "text": { "type": "string" }
          }
        }
      }
    },
    "zodiac": {
      "type": "object",
      "required": ["id", "chinese", "branch", "branch_index"],
      "properties": {
        "id": { "type": "string" },
        "chinese": { "type": "string" },
        "branch": { "type": "string" },
        "branch_index": { "type": "integer", "minimum": 0, "maximum": 11 }
      }
    },
    "rules": {
      "type": "object",
      "required": ["year_boundary"],
      "properties": {
        "year_boundary": {
          "type": "string",
          "enum": ["chunjie", "lichun_day", "lichun_exact"]
        }
      }
    },
    "provider": { "type": "string" },
    "solar_term": {
      "type": ["object", "null"],
      "description": "Reserved; populated from alpha.2"
    }
  }
}
