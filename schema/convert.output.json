{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mystilink.example/schema/convert.output.json",
  "title": "mystilink-lunar convert output (alpha.3)",
  "type": "object",
  "required": ["solar", "lunar", "ganzhi", "zodiac", "rules", "provider", "solar_term"],
  "properties": {
    "solar": {
      "type": "object",
      "required": ["datetime", "timezone", "year", "month", "day"],
      "properties": {
        "datetime": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string" },
        "year": { "type": "integer" },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 }
      }
    },
    "lunar": {
      "type": "object",
      "required": ["year", "month", "day", "is_leap_month"],
      "properties": {
        "year": { "type": "integer" },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": 1, "maximum": 30 },
        "is_leap_month": { "type": "boolean" }
      }
    },
    "ganzhi": {
      "type": "object",
      "required": ["year", "month", "day", "hour"],
      "properties": {
        "year": { "$ref": "#/$defs/ganzhi" },
        "month": { "$ref": "#/$defs/ganzhi" },
        "day": { "$ref": "#/$defs/ganzhi" },
        "hour": { "$ref": "#/$defs/ganzhi" }
      }
    },
    "ganzhi_explain": {
      "type": "object",
      "description": "Present when CLI --explain is set",
      "required": ["year", "month", "day", "hour", "rules"],
      "properties": {
        "year": { "$ref": "#/$defs/pillarTrace" },
        "month": { "$ref": "#/$defs/pillarTrace" },
        "day": { "$ref": "#/$defs/pillarTrace" },
        "hour": { "$ref": "#/$defs/pillarTrace" },
        "rules": { "type": "object" }
      }
    },
    "zodiac": {
      "type": "object",
      "required": ["id", "chinese", "branch", "branch_index"],
      "properties": {
        "id": { "type": "string" },
        "chinese": { "type": "string" },
        "branch": { "type": "string" },
        "branch_index": { "type": "integer", "minimum": 0, "maximum": 11 }
      }
    },
    "rules": {
      "type": "object",
      "required": ["year_boundary", "month_boundary", "day_boundary", "hour_system"],
      "properties": {
        "year_boundary": {
          "type": "string",
          "enum": ["chunjie", "lichun_day", "lichun_exact"]
        },
        "month_boundary": {
          "type": "string",
          "enum": ["jie_exact", "jie_day", "lunar_month"]
        },
        "day_boundary": {
          "type": "string",
          "enum": ["midnight", "zi_start"]
        },
        "hour_system": {
          "type": "string",
          "enum": ["double_hour"]
        }
      }
    },
    "provider": { "type": "string" },
    "solar_term": {
      "type": "object",
      "required": ["previous", "next"],
      "properties": {
        "previous": { "$ref": "#/$defs/solarTerm" },
        "next": { "$ref": "#/$defs/solarTerm" }
      }
    }
  },
  "$defs": {
    "ganzhi": {
      "type": "object",
      "required": ["stem_index", "branch_index", "stem", "branch", "text"],
      "properties": {
        "stem_index": { "type": "integer", "minimum": 0, "maximum": 9 },
        "branch_index": { "type": "integer", "minimum": 0, "maximum": 11 },
        "stem": { "type": "string" },
        "branch": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "pillarTrace": {
      "type": "object",
      "required": ["value", "stem_index", "branch_index", "boundary", "reason"],
      "properties": {
        "value": { "type": "string" },
        "stem_index": { "type": "integer" },
        "branch_index": { "type": "integer" },
        "boundary": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "solarTerm": {
      "type": ["object", "null"],
      "required": ["index", "id", "name", "chinese_name", "solar_longitude", "datetime"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 23 },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "chinese_name": { "type": "string" },
        "solar_longitude": { "type": "number" },
        "datetime": { "type": "string", "format": "date-time" }
      }
    }
  }
}
